# clang-tidy configuration. Run via:
#   clang-tidy-18 -p out/build/dev <file>
---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-else-after-return,
  -readability-function-cognitive-complexity
WarningsAsErrors: ''
HeaderFilterRegex: '^.*/(include|src)/ainsc/.*'
FormatStyle: file
SystemHeaders: false
...
